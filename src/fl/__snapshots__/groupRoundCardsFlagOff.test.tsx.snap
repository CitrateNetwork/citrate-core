// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`FL round cards flag OFF: behaviour is unchanged > Groups › Rounds renders the same markup as before the feature 1`] = `"<div role="tablist" data-testid="place-tabs" style="display:flex;gap:4px;padding:10px 26px 0;border-bottom:1px solid var(--line-1);flex-shrink:0"><button role="tab" aria-selected="false" class="mono" style="font-size:11px;letter-spacing:.06em;padding:7px 12px;border:none;border-bottom:2px solid transparent;border-radius:0;background:transparent;color:var(--tx-3);cursor:pointer">Chat</button><button role="tab" aria-selected="true" class="mono" style="font-size:11px;letter-spacing:.06em;padding:7px 12px;border:none;border-bottom:2px solid var(--accent);border-radius:0;background:transparent;color:var(--tx-1);cursor:pointer">Rounds</button><button role="tab" aria-selected="false" class="mono" style="font-size:11px;letter-spacing:.06em;padding:7px 12px;border:none;border-bottom:2px solid transparent;border-radius:0;background:transparent;color:var(--tx-3);cursor:pointer">Members</button><button role="tab" aria-selected="false" class="mono" style="font-size:11px;letter-spacing:.06em;padding:7px 12px;border:none;border-bottom:2px solid transparent;border-radius:0;background:transparent;color:var(--tx-3);cursor:pointer">Cluster</button></div><div role="tablist" data-testid="place-subtabs" style="display:flex;gap:4px;padding:6px 26px 0;border-bottom:none;flex-shrink:0"><button role="tab" aria-selected="true" class="mono" style="font-size:10.5px;letter-spacing:.06em;padding:5px 10px;border:none;border-bottom:none;border-radius:var(--r-1);background:var(--srf-2);color:var(--tx-1);cursor:pointer">Matches</button><button role="tab" aria-selected="false" class="mono" style="font-size:10.5px;letter-spacing:.06em;padding:5px 10px;border:none;border-bottom:none;border-radius:var(--r-1);background:transparent;color:var(--tx-3);cursor:pointer">Live round</button><button role="tab" aria-selected="false" class="mono" style="font-size:10.5px;letter-spacing:.06em;padding:5px 10px;border:none;border-bottom:none;border-radius:var(--r-1);background:transparent;color:var(--tx-3);cursor:pointer">Open a round</button><button role="tab" aria-selected="false" class="mono" style="font-size:10.5px;letter-spacing:.06em;padding:5px 10px;border:none;border-bottom:none;border-radius:var(--r-1);background:transparent;color:var(--tx-3);cursor:pointer">Datasets</button><button role="tab" aria-selected="false" class="mono" style="font-size:10.5px;letter-spacing:.06em;padding:5px 10px;border:none;border-bottom:none;border-radius:var(--r-1);background:transparent;color:var(--tx-3);cursor:pointer">Adapters</button><button role="tab" aria-selected="false" class="mono" style="font-size:10.5px;letter-spacing:.06em;padding:5px 10px;border:none;border-bottom:none;border-radius:var(--r-1);background:transparent;color:var(--tx-3);cursor:pointer">Payouts</button></div><div data-surface="groups/rounds" style="flex:1;min-height:0;overflow:auto"><div style="padding:20px 26px 24px;display:flex;flex-direction:column;gap:16px;max-width:900px"><div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap"><span style="font-family:var(--font-display);font-weight:420;font-size:24px">Train together</span><span class="mono" style="font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;padding:2px 9px;border-radius:999px;border:1px solid var(--warn);color:var(--warn);background:var(--warn-bg);flex-shrink:0">not live yet</span></div><div class="surface" style="padding:18px;display:flex;flex-direction:column;gap:8px"><span style="font-size:14px;font-weight:500">Group rounds not live yet</span><p style="font-size:12.5px;color:var(--tx-2);line-height:1.6;margin:0;max-width:660px">Both ledgers group rounds need, PatronageLedger and FederatedRoundLedger, are deployed on 40204, but no round can be recorded on them yet. Rounds, contributions and claims appear here once they can. Nothing on this card is read from a round in the meantime.</p><span class="mono" style="font-size:10px;color:var(--tx-3)">source · address book 40204 (both ledgers pinned)</span></div><span class="mono" style="font-size:10px;color:var(--tx-3)">below: local adapter rounds through a coordinator · on-chain group rounds are not live yet</span><div class="surface" style="display:flex;flex-direction:column"><div style="display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid var(--line-1)"><span style="font-size:14px;font-weight:500">Federated rounds with Hermes</span><span class="mono" style="margin-left:auto;font-size:10px;color:var(--tx-3)">you approve every start · adapters load only after the eval gate</span></div><div style="padding:18px;display:flex;flex-direction:column;gap:16px"><div data-testid="fl-trajectories" style="display:flex;flex-direction:column;gap:8px"><span class="mono" style="font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--tx-3)">Training data</span><label style="display:flex;align-items:center;gap:8px;font-size:12.5px"><input type="checkbox" data-testid="fl-traj-toggle" disabled=""/>Train on my verified conversations</label><p style="font-size:12.5px;color:var(--tx-2);line-height:1.6;margin:0" data-testid="fl-traj-explain">Off (the default). Hermes records nothing for training, and no training set can be built. Turning it on lets verified, redacted conversations feed a round you join; each round still asks for its own consent.</p></div><div data-testid="fl-coordinator" style="display:flex;flex-direction:column;gap:8px"><span class="mono" style="font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--tx-3)">Coordinator</span><p style="font-size:12.5px;color:var(--tx-2);line-height:1.6;margin:0">No training coordinator is configured. Live rounds need one: an operator runs it (HUP-S9.1/S9.2), then you enter its address here.</p><div style="display:flex;gap:8px"><input class="input" data-testid="fl-coordinator-input" placeholder="https://coordinator.example.org" style="flex:1" value=""/><button class="btn btn-secondary" data-testid="fl-coordinator-save">Save</button></div></div><div style="display:flex;flex-direction:column;gap:8px"><input class="input" data-testid="fl-round-id" placeholder="round id (0x…, optional, as the operator published it)" value=""/><div style="display:flex;gap:10px"><button class="btn btn-secondary" data-testid="fl-plan">Plan a round</button><button class="btn btn-primary" data-testid="fl-start" disabled="">Join this round</button></div></div><div data-testid="fl-consents" style="display:flex;flex-direction:column;gap:6px"><span class="mono" style="font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--tx-3)">Round consent</span><p style="font-size:12.5px;color:var(--tx-2);line-height:1.6;margin:0">No round consent on this device. Joining a plan that names a round writes consent for that round only.</p></div><div style="display:flex;flex-direction:column;gap:8px"><span class="mono" style="font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--tx-3)">Round adapter and the eval gate</span><p style="font-size:12.5px;color:var(--tx-2);line-height:1.6;margin:0">Downloading a round&#x27;s adapter from LoRAFactory is not deployed yet. Give the adapter file and its published sha256 (or the round result the round tool wrote, which names the merged adapter; core checks that the file says Accepted, names at least three devices, and that its chain, bundle and replay digests agree, but does not read the ledger itself), plus the eval scorecards for the base model and for the base model with this adapter (scripts/eval-tools.mjs, optionally scripts/eval-qa.mjs, with --model set to the base model&#x27;s file name and --adapter-sha256). The adapter loads only if nothing got worse and the score improved.</p><input class="input" data-testid="fl-gate-adapter" placeholder="adapter .gguf path" value=""/><input class="input" data-testid="fl-gate-round" placeholder="round result .json from the round tool (optional)" value=""/><input class="input" data-testid="fl-gate-sha" placeholder="expected sha256 (may be empty with a round result)" value=""/><input class="input" data-testid="fl-gate-base-tools" placeholder="base tool-call scorecard .json" value=""/><input class="input" data-testid="fl-gate-cand-tools" placeholder="candidate tool-call scorecard .json" value=""/><input class="input" data-testid="fl-gate-base-qa" placeholder="base QA scorecard .json (optional)" value=""/><input class="input" data-testid="fl-gate-cand-qa" placeholder="candidate QA scorecard .json (optional)" value=""/><div><button class="btn btn-secondary" data-testid="fl-gate-run">Run the eval gate</button></div></div></div></div></div></div>"`;

exports[`FL round cards flag OFF: behaviour is unchanged > a group's chat renders the same markup as before the feature 1`] = `"<div class="grp-page grp-cols-3" data-board="group-chat" data-state="thread"><aside class="grp-col grp-list-col" aria-label="Your groups"><span class="grp-inline"><button class="btn btn-primary btn-sm">Create a group</button><button class="btn btn-sm">Join with an invite</button></span><span title="Comms not started yet this session." style="display:inline-flex;align-items:center;gap:6px;font-family:var(--font-sans);font-size:11.5px;color:var(--fg-2);padding:2px 8px;border:1px solid var(--line-1);border-radius:999px;white-space:nowrap"><span aria-hidden="true" style="width:7px;height:7px;border-radius:999px;background:var(--fg-3, #8a8f88);box-shadow:0 0 0 2px color-mix(in srgb, var(--fg-3, #8a8f88) 22%, transparent)"></span><span>Relay idle</span><style>@keyframes relayPulse { 0%,100%{opacity:1} 50%{opacity:.35} }</style></span><label class="sr-only" for="grp-search">Search groups</label><input id="grp-search" class="input" placeholder="Search groups" value=""/><div style="display:flex;flex-direction:column;gap:8px" data-testid="have-an-invite"></div><nav aria-label="Groups"><button class="grp-group-btn" aria-current="page"><span class="grp-avatar" aria-hidden="true">GA</span><span class="grp-stack" style="flex:1"><span style="font-size:13px;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Garden club</span></span></button></nav></aside><main class="grp-thread" aria-labelledby="thread-h"><div class="grp-thread-head"><h1 id="thread-h" class="grp-h1" style="font-size:20px">Garden club</h1><span class="fl-chip">Circle</span><span class="fl-chip" title="The comms daemon this app runs does not report the MLS epoch yet." data-testid="group-epoch">Encrypted · epoch —<span class="sr-only"> (The comms daemon this app runs does not report the MLS epoch yet.)</span></span><span class="grp-spacer"></span><button class="btn btn-ghost btn-sm" title="Reading the group&#x27;s cluster.">0 members · online —</button></div><div class="grp-thread-scroll" aria-live="polite" aria-relevant="additions" data-testid="group-thread"><p class="grp-note" style="margin:auto;text-align:center;max-width:360px">Nothing here yet. Messages reach every member of this group, and nobody outside it.</p></div><div class="grp-composer"><div class="grp-inline" style="flex-wrap:nowrap;align-items:flex-end"><button class="btn btn-ghost btn-sm" aria-label="Share a file" title="Share a file">File</button><label class="sr-only" for="grp-msg">Message Garden club</label><textarea id="grp-msg" class="input" rows="1" style="flex:1;min-width:0" placeholder="Message Garden club"></textarea><button class="btn btn-ghost btn-sm">@Hermes</button><button class="btn btn-primary btn-sm" disabled="">Send</button></div><span class="grp-faint">@Hermes runs on your device; its reply is posted to everyone in this group.</span></div></main><aside class="grp-col grp-rail" aria-label="Group details"><section class="grp-stack" style="gap:6px"><span class="eyebrow">Garden club</span><span class="grp-inline"><span class="grp-muted" style="font-size:12px">Your role</span><span class="fl-chip fl-chip-ok">—</span></span></section><section class="grp-stack" style="gap:6px"><span class="grp-inline"><span class="eyebrow">Members</span><span class="grp-spacer"></span><button class="btn btn-sm">View all</button></span><ul class="grp-list" aria-label="Members and presence"></ul></section><section class="grp-stack" style="gap:6px"><span class="eyebrow">Cluster</span><div class="fl-card-2 grp-stats"><div><div class="grp-stat-v">—</div><div class="grp-faint">the cluster did not answer</div></div><div><div class="grp-stat-v">—</div><div class="grp-faint">shared files</div></div></div><span><button class="btn btn-ghost btn-sm">Open the cluster map</button></span></section><section class="grp-stack" style="gap:6px" data-testid="rail-rounds"><span class="eyebrow">Rounds</span><span class="grp-note">Group rounds not live yet. WorkMarket is not available yet on this network.</span></section></aside></div>"`;
