exports[`FL round cards flag OFF: behaviour is unchanged > Groups › Rounds renders the same markup as before the feature 1`] = `"<div role="tablist" data-testid="place-tabs" style="display:flex;gap:4px;padding:10px 26px 0;border-bottom:1px solid var(--line-1);flex-shrink:0"><button role="tab" aria-selected="false" class="mono" style="font-size:11px;letter-spacing:.06em;padding:7px 12px;border:none;border-bottom:2px solid transparent;border-radius:0;background:transparent;color:var(--tx-3);cursor:pointer">Chat</button><button role="tab" aria-selected="true" class="mono" style="font-size:11px;letter-spacing:.06em;padding:7px 12px;border:none;border-bottom:2px solid var(--accent);border-radius:0;background:transparent;color:var(--tx-1);cursor:pointer">Rounds</button><button role="tab" aria-selected="false" class="mono" style="font-size:11px;letter-spacing:.06em;padding:7px 12px;border:none;border-bottom:2px solid transparent;border-radius:0;background:transparent;color:var(--tx-3);cursor:pointer">Members</button><button role="tab" aria-selected="false" class="mono" style="font-size:11px;letter-spacing:.06em;padding:7px 12px;border:none;border-bottom:2px solid transparent;border-radius:0;background:transparent;color:var(--tx-3);cursor:pointer">Cluster</button></div><div role="tablist" data-testid="place-subtabs" style="display:flex;gap:4px;padding:6px 26px 0;border-bottom:none;flex-shrink:0"><button role="tab" aria-selected="true" class="mono" style="font-size:10.5px;letter-spacing:.06em;padding:5px 10px;border:none;border-bottom:none;border-radius:var(--r-1);background:var(--srf-2);color:var(--tx-1);cursor:pointer">Matches</button><button role="tab" aria-selected="false" class="mono" style="font-size:10.5px;letter-spacing:.06em;padding:5px 10px;border:none;border-bottom:none;border-radius:var(--r-1);background:transparent;color:var(--tx-3);cursor:pointer">Live round</button><button role="tab" aria-selected="false" class="mono" style="font-size:10.5px;letter-spacing:.06em;padding:5px 10px;border:none;border-bottom:none;border-radius:var(--r-1);background:transparent;color:var(--tx-3);cursor:pointer">Open a round</button><button role="tab" aria-selected="false" class="mono" style="font-size:10.5px;letter-spacing:.06em;padding:5px 10px;border:none;border-bottom:none;border-radius:var(--r-1);background:transparent;color:var(--tx-3);cursor:pointer">Datasets</button><button role="tab" aria-selected="false" class="mono" style="font-size:10.5px;letter-spacing:.06em;padding:5px 10px;border:none;border-bottom:none;border-radius:var(--r-1);background:transparent;color:var(--tx-3);cursor:pointer">Adapters</button><button role="tab" aria-selected="false" class="mono" style="font-size:10.5px;letter-spacing:.06em;padding:5px 10px;border:none;border-bottom:none;border-radius:var(--r-1);background:transparent;color:var(--tx-3);cursor:pointer">Payouts</button></div><div data-surface="groups/rounds" style="flex:1;min-height:0;overflow:auto"><div class="fl-band" data-testid="fl-band" role="region" aria-label="This machine and network"><div style="display:flex;flex-direction:column;gap:2px"><span class="eyebrow" style="font-size:10px">Network</span><span style="font-size:13px">Citrate testnet (r1007 genesis, 0.5.3)</span></div><div style="display:flex;flex-direction:column;gap:2px"><span class="eyebrow" style="font-size:10px">Wallet</span><span class="mono" style="font-size:13px" title="Read from eth_getBalance">0.00 SALT</span></div><div style="display:flex;flex-direction:column;gap:2px"><span class="eyebrow" style="font-size:10px">Training worker</span><span style="font-size:13px">Not bundled in this release</span></div><div style="display:flex;flex-direction:column;gap:2px"><span class="eyebrow" style="font-size:10px">In the background</span><span style="font-size:13px;display:flex;gap:6px;align-items:center"><span aria-hidden="true" style="width:7px;height:7px;border-radius:999px;background:var(--tx-3)"></span>Node off</span></div><span style="flex:1"></span><span style="font-size:11.5px;max-width:360px;opacity:0.8">SALT amounts are what contracts escrowed and paid.</span></div><section class="fl-main" data-testid="matches-today" data-phase="today" aria-labelledby="matches-today-h"><span class="fl-chip fl-chip-warn" data-tone="warn" style="align-self:flex-start">Group rounds not live yet</span><h1 id="matches-today-h" class="fl-disp" style="font-size:24px;max-width:720px">Rounds open on this network after the WorkMarket contract is deployed.</h1><div class="fl-muted" style="margin:0;font-size:13.5px;line-height:1.55;max-width:680px"><p style="margin:0">Check whether this machine can take part, and check an adapter file against the eval gate.</p></div><table class="fl-tbl" data-testid="fl-contract-table" style="max-width:760px"><thead><tr><th style="width:30%">Contract</th><th style="width:48%">On this network</th><th>Source</th></tr></thead><tbody><tr data-contract="FederatedRoundLedger" data-kind="reading"><td>FederatedRoundLedger</td><td>Reading</td><td><span class="fl-src" title="Read from eth_getCode">eth_getCode</span></td></tr><tr data-contract="PatronageLedger" data-kind="reading"><td>PatronageLedger</td><td>Reading</td><td><span class="fl-src" title="Read from eth_getCode">eth_getCode</span></td></tr><tr data-contract="LoRAFactory" data-kind="reading"><td>LoRAFactory</td><td>Reading</td><td><span class="fl-src" title="Read from eth_getCode">eth_getCode</span></td></tr><tr data-contract="WorkMarket" data-kind="not-in-book"><td>WorkMarket</td><td>Not available yet on this network</td><td><span class="fl-src" title="Read from address book">address book</span></td></tr></tbody></table><p class="fl-note">No training starts from the app yet: the training worker is not bundled in this release.</p><div style="display:flex;gap:8px;flex-wrap:wrap"><button type="button" class="btn btn-primary">Check an adapter file</button><button type="button" class="btn btn-ghost">Ask Hermes</button><button type="button" class="btn btn-ghost">Advanced</button></div></section></div>"`;

exports[`FL round cards flag OFF: behaviour is unchanged > a group's chat renders the same markup as before the feature 1`] = `"<div style="display:flex;flex-direction:column;min-height:100%;box-sizing:border-box"><div style="border-bottom:1px solid var(--line-1);background:var(--srf-1);padding:12px 20px;display:flex;flex-direction:column;gap:10px;flex-shrink:0"><div style="display:flex;align-items:center;gap:12px"><span style="font-family:var(--font-display);font-weight:420;font-size:19px;flex-shrink:0">Groups</span><span title="Comms not started yet this session." style="display:inline-flex;align-items:center;gap:6px;font-family:var(--font-sans);font-size:11.5px;color:var(--fg-2);padding:2px 8px;border:1px solid var(--line-1);border-radius:999px;white-space:nowrap"><span aria-hidden="true" style="width:7px;height:7px;border-radius:999px;background:var(--fg-3, #8a8f88);box-shadow:0 0 0 2px color-mix(in srgb, var(--fg-3, #8a8f88) 22%, transparent)"></span><span>Relay idle</span><style>@keyframes relayPulse { 0%,100%{opacity:1} 50%{opacity:.35} }</style></span><div style="display:flex;gap:6px;overflow-x:auto;flex:1;min-width:0;padding:2px 0"><button title="Garden club" style="display:inline-flex;align-items:center;gap:7px;padding:6px 12px;border-radius:999px;border:1px solid var(--accent);background:var(--srf-2);color:var(--tx-1);cursor:pointer;white-space:nowrap;flex-shrink:0;font-size:12.5px;font-weight:500"><span class="mono" style="width:20px;height:20px;border-radius:6px;border:1px solid var(--line-2);background:#fff;color:var(--tx-2);display:inline-flex;align-items:center;justify-content:center;font-size:9px;font-weight:600">GA</span><span style="max-width:180px;overflow:hidden;text-overflow:ellipsis">Garden club</span></button></div><span style="margin-left:auto;display:flex;gap:6px;flex-shrink:0"><button class="btn btn-secondary btn-sm">New group</button></span></div><div style="display:flex;flex-direction:column;gap:8px" data-testid="have-an-invite"><button class="btn btn-ghost btn-sm" data-testid="invite-paste-open" style="align-self:flex-start">Have an invite?</button></div></div><div style="flex:1;display:flex;flex-direction:column;min-height:0"><div style="display:flex;align-items:center;gap:12px;padding:16px 24px 0;flex-wrap:wrap"><span style="font-family:var(--font-display);font-weight:420;font-size:22px;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%">Garden club</span><span class="mono" style="font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;padding:2px 9px;border-radius:999px;border:1px solid var(--line-2);color:var(--tx-2);flex-shrink:0">Circle</span><span class="mono" style="font-size:10px;color:var(--tx-3);flex-shrink:0">0xababababab…</span><span style="display:flex;gap:2px;background:var(--srf-1);border:1px solid var(--line-1);border-radius:var(--r-1);padding:2px;margin-left:auto;flex-shrink:0"><button style="font-family:var(--font-sans);font-size:12px;font-weight:500;padding:5px 12px;border:none;border-radius:5px;cursor:pointer;background:var(--srf-2);color:var(--tx-1)">Conversation</button><button style="font-family:var(--font-sans);font-size:12px;font-weight:400;padding:5px 12px;border:none;border-radius:5px;cursor:pointer;background:transparent;color:var(--tx-2)">People</button><button style="font-family:var(--font-sans);font-size:12px;font-weight:400;padding:5px 12px;border:none;border-radius:5px;cursor:pointer;background:transparent;color:var(--tx-2)">Cluster</button></span></div><div style="flex:1;min-height:0;display:flex;flex-direction:column;padding:14px 24px 20px;gap:12px"><div class="surface" style="flex:1;min-height:280px;overflow:auto;padding:16px;display:flex;flex-direction:column;gap:14px"><p style="font-size:12.5px;line-height:1.6;color:var(--tx-3);margin:auto;text-align:center;max-width:340px">Nothing here yet. Say hello — messages are relayed to every member and readable by the roles you see in the roster.</p></div><div style="display:flex;gap:10px"><input class="input" placeholder="Message the group…" style="flex:1"/><button class="btn btn-primary">Send</button></div></div></div></div>"`;
