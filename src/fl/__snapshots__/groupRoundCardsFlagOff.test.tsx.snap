// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`FL round cards flag OFF: behaviour is unchanged > Groups › Rounds renders the same markup as before the feature 1`] = `"<div role="tablist" data-testid="place-tabs" style="display:flex;gap:4px;padding:10px 26px 0;border-bottom:1px solid var(--line-1);flex-shrink:0"><button role="tab" aria-selected="false" class="mono" style="font-size:11px;letter-spacing:.06em;padding:7px 12px;border:none;border-bottom:2px solid transparent;border-radius:0;background:transparent;color:var(--tx-3);cursor:pointer">Chat</button><button role="tab" aria-selected="true" class="mono" style="font-size:11px;letter-spacing:.06em;padding:7px 12px;border:none;border-bottom:2px solid var(--accent);border-radius:0;background:transparent;color:var(--tx-1);cursor:pointer">Rounds</button><button role="tab" aria-selected="false" class="mono" style="font-size:11px;letter-spacing:.06em;padding:7px 12px;border:none;border-bottom:2px solid transparent;border-radius:0;background:transparent;color:var(--tx-3);cursor:pointer">Members</button><button role="tab" aria-selected="false" class="mono" style="font-size:11px;letter-spacing:.06em;padding:7px 12px;border:none;border-bottom:2px solid transparent;border-radius:0;background:transparent;color:var(--tx-3);cursor:pointer">Cluster</button></div><div data-surface="groups/rounds" style="flex:1;min-height:0;overflow:auto"><div style="padding:20px 26px 24px;display:flex;flex-direction:column;gap:16px;max-width:900px"><div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap"><span style="font-family:var(--font-display);font-weight:420;font-size:24px">Train together</span><span class="mono" style="font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;padding:2px 9px;border-radius:999px;border:1px solid var(--warn);color:var(--warn);background:var(--warn-bg);flex-shrink:0">not live yet</span></div><div class="surface" style="padding:18px;display:flex;flex-direction:column;gap:8px"><span style="font-size:14px;font-weight:500">Group rounds not live yet</span><p style="font-size:12.5px;color:var(--tx-2);line-height:1.6;margin:0;max-width:660px">Group training rounds need two contracts, PatronageLedger and FederatedRoundLedger, and neither is deployed on betanet yet. Rounds, contributions and claims appear here once they are. Nothing on this card is read from a round in the meantime.</p><span class="mono" style="font-size:10px;color:var(--tx-3)">source · address book 40204 (no PatronageLedger entry)</span></div><span class="mono" style="font-size:10px;color:var(--tx-3)">below: local adapter rounds through a coordinator · on-chain group rounds are not live yet</span><div class="surface" style="display:flex;flex-direction:column"><div style="display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid var(--line-1)"><span style="font-size:14px;font-weight:500">Federated rounds with Hermes</span><span class="mono" style="margin-left:auto;font-size:10px;color:var(--tx-3)">you approve every start · adapters load only after the eval gate</span></div><div style="padding:18px;display:flex;flex-direction:column;gap:16px"><div data-testid="fl-trajectories" style="display:flex;flex-direction:column;gap:8px"><span class="mono" style="font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--tx-3)">Training data</span><label style="display:flex;align-items:center;gap:8px;font-size:12.5px"><input type="checkbox" data-testid="fl-traj-toggle" disabled=""/>Train on my verified conversations</label><p style="font-size:12.5px;color:var(--tx-2);line-height:1.6;margin:0" data-testid="fl-traj-explain">Off (the default). Hermes records nothing for training, and no training set can be built. Turning it on lets verified, redacted conversations feed a round you join; each round still asks for its own consent.</p></div><div data-testid="fl-coordinator" style="display:flex;flex-direction:column;gap:8px"><span class="mono" style="font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--tx-3)">Coordinator</span><p style="font-size:12.5px;color:var(--tx-2);line-height:1.6;margin:0">No training coordinator is configured. Live rounds need one: an operator runs it (HUP-S9.1/S9.2), then you enter its address here.</p><div style="display:flex;gap:8px"><input class="input" data-testid="fl-coordinator-input" placeholder="https://coordinator.example.org" style="flex:1" value=""/><button class="btn btn-secondary" data-testid="fl-coordinator-save">Save</button></div></div><div style="display:flex;flex-direction:column;gap:8px"><input class="input" data-testid="fl-round-id" placeholder="round id (0x…, optional, as the operator published it)" value=""/><div style="display:flex;gap:10px"><button class="btn btn-secondary" data-testid="fl-plan">Plan a round</button><button class="btn btn-primary" data-testid="fl-start" disabled="">Join this round</button></div></div><div data-testid="fl-consents" style="display:flex;flex-direction:column;gap:6px"><span class="mono" style="font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--tx-3)">Round consent</span><p style="font-size:12.5px;color:var(--tx-2);line-height:1.6;margin:0">No round consent on this device. Joining a plan that names a round writes consent for that round only.</p></div><div style="display:flex;flex-direction:column;gap:8px"><span class="mono" style="font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--tx-3)">Round adapter and the eval gate</span><p style="font-size:12.5px;color:var(--tx-2);line-height:1.6;margin:0">Downloading a round&#x27;s adapter from LoRAFactory is not deployed yet. Give the adapter file and its published sha256 (or the round result the round tool wrote, which names the merged adapter; core checks that the file says Accepted, names at least three devices, and that its chain, bundle and replay digests agree, but does not read the ledger itself), plus the eval scorecards for the base model and for the base model with this adapter (scripts/eval-tools.mjs, optionally scripts/eval-qa.mjs, with --model set to the base model&#x27;s file name and --adapter-sha256). The adapter loads only if nothing got worse and the score improved.</p><input class="input" data-testid="fl-gate-adapter" placeholder="adapter .gguf path" value=""/><input class="input" data-testid="fl-gate-round" placeholder="round result .json from the round tool (optional)" value=""/><input class="input" data-testid="fl-gate-sha" placeholder="expected sha256 (may be empty with a round result)" value=""/><input class="input" data-testid="fl-gate-base-tools" placeholder="base tool-call scorecard .json" value=""/><input class="input" data-testid="fl-gate-cand-tools" placeholder="candidate tool-call scorecard .json" value=""/><input class="input" data-testid="fl-gate-base-qa" placeholder="base QA scorecard .json (optional)" value=""/><input class="input" data-testid="fl-gate-cand-qa" placeholder="candidate QA scorecard .json (optional)" value=""/><div><button class="btn btn-secondary" data-testid="fl-gate-run">Run the eval gate</button></div></div></div></div></div></div>"`;

exports[`FL round cards flag OFF: behaviour is unchanged > a group's chat renders the same markup as before the feature 1`] = `"<div style="display:flex;flex-direction:column;min-height:100%;box-sizing:border-box"><div style="border-bottom:1px solid var(--line-1);background:var(--srf-1);padding:12px 20px;display:flex;flex-direction:column;gap:10px;flex-shrink:0"><div style="display:flex;align-items:center;gap:12px"><span style="font-family:var(--font-display);font-weight:420;font-size:19px;flex-shrink:0">Groups</span><span title="Comms not started yet this session." style="display:inline-flex;align-items:center;gap:6px;font-family:var(--font-sans);font-size:11.5px;color:var(--fg-2);padding:2px 8px;border:1px solid var(--line-1);border-radius:999px;white-space:nowrap"><span aria-hidden="true" style="width:7px;height:7px;border-radius:999px;background:var(--fg-3, #8a8f88);box-shadow:0 0 0 2px color-mix(in srgb, var(--fg-3, #8a8f88) 22%, transparent)"></span><span>Relay idle</span><style>@keyframes relayPulse { 0%,100%{opacity:1} 50%{opacity:.35} }</style></span><div style="display:flex;gap:6px;overflow-x:auto;flex:1;min-width:0;padding:2px 0"><button title="Garden club" style="display:inline-flex;align-items:center;gap:7px;padding:6px 12px;border-radius:999px;border:1px solid var(--accent);background:var(--srf-2);color:var(--tx-1);cursor:pointer;white-space:nowrap;flex-shrink:0;font-size:12.5px;font-weight:500"><span class="mono" style="width:20px;height:20px;border-radius:6px;border:1px solid var(--line-2);background:#fff;color:var(--tx-2);display:inline-flex;align-items:center;justify-content:center;font-size:9px;font-weight:600">GA</span><span style="max-width:180px;overflow:hidden;text-overflow:ellipsis">Garden club</span></button></div><span style="margin-left:auto;display:flex;gap:6px;flex-shrink:0"><button class="btn btn-ghost btn-sm">Have an invite?</button><button class="btn btn-secondary btn-sm">New group</button></span></div></div><div style="flex:1;display:flex;flex-direction:column;min-height:0"><div style="display:flex;align-items:center;gap:12px;padding:16px 24px 0;flex-wrap:wrap"><span style="font-family:var(--font-display);font-weight:420;font-size:22px;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%">Garden club</span><span class="mono" style="font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;padding:2px 9px;border-radius:999px;border:1px solid var(--line-2);color:var(--tx-2);flex-shrink:0">Circle</span><span class="mono" style="font-size:10px;color:var(--tx-3);flex-shrink:0">0xababababab…</span><span style="display:flex;gap:2px;background:var(--srf-1);border:1px solid var(--line-1);border-radius:var(--r-1);padding:2px;margin-left:auto;flex-shrink:0"><button style="font-family:var(--font-sans);font-size:12px;font-weight:500;padding:5px 12px;border:none;border-radius:5px;cursor:pointer;background:var(--srf-2);color:var(--tx-1)">Conversation</button><button style="font-family:var(--font-sans);font-size:12px;font-weight:400;padding:5px 12px;border:none;border-radius:5px;cursor:pointer;background:transparent;color:var(--tx-2)">People</button><button style="font-family:var(--font-sans);font-size:12px;font-weight:400;padding:5px 12px;border:none;border-radius:5px;cursor:pointer;background:transparent;color:var(--tx-2)">Cluster</button></span></div><div style="flex:1;min-height:0;display:flex;flex-direction:column;padding:14px 24px 20px;gap:12px"><div class="surface" style="flex:1;min-height:280px;overflow:auto;padding:16px;display:flex;flex-direction:column;gap:14px"><p style="font-size:12.5px;line-height:1.6;color:var(--tx-3);margin:auto;text-align:center;max-width:340px">Nothing here yet. Say hello — messages are relayed to every member and readable by the roles you see in the roster.</p></div><div style="display:flex;gap:10px"><input class="input" placeholder="Message the group…" style="flex:1"/><button class="btn btn-primary">Send</button></div></div></div></div>"`;
