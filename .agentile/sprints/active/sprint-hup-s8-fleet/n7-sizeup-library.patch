+#[test]
+fn roles_are_sizeups_and_parse_strictly() {
+    // HUP F-10: the mapping is citrate-sizeup's `library::Role::for_tier`, not a local copy.
+    for id in ["T0", "T1", "T2"] {
+        let lib = sizeup_core::library::Tier::parse(id).map(sizeup_core::library::Role::for_tier);
+        assert_eq!(lib.map(|r| r.id()), Some(role_for(Some(id))));
+    }
+    assert_eq!(role_for(Some("t1")), "unknown");
+    assert_eq!(role_for(Some(" T1")), "unknown");
+    assert_eq!(role_for(Some("")), "unknown");
+}
