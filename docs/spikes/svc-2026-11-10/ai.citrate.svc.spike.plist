<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.citrate.svc</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/Citrate Core.app/Contents/MacOS/svc-spike.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>SPIKE_BIN</key>
		<string>/Applications/Citrate Core.app/Contents/MacOS</string>
		<key>SPIKE_DATA</key>
		<string>/Users/USER/Library/Application Support/ai.citrate.core-spike</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ExitTimeOut</key>
	<integer>40</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>Umask</key>
	<integer>63</integer>
	<key>StandardOutPath</key>
	<string>/Users/USER/Library/Logs/ai.citrate.core/svc.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/USER/Library/Logs/ai.citrate.core/svc.log</string>
</dict>
</plist>
