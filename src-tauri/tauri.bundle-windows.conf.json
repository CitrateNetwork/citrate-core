{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "externalBin": [
      "binaries/citrate",
      "binaries/node-agent",
      "binaries/mem-mcp",
      "binaries/llama-server",
      "binaries/ipfs",
      "binaries/comms-member-daemon",
      "binaries/cluster-daemon",
      "binaries/hermes"
    ],
    "resources": [
      "llama/*",
      "models/bge-base-en-v1.5/*",
      "docs-corpus/*",
      "capsules/hello/*",
      "capsules/echo-chain/*"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
