{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "createUpdaterArtifacts": false,
    "externalBin": [
      "binaries/citrate",
      "binaries/node-agent",
      "binaries/mem-mcp",
      "binaries/llama-server",
      "binaries/ipfs",
      "binaries/comms-member-daemon",
      "binaries/cluster-daemon",
      "binaries/hermes"
    ],
    "resources": [
      "llama/*",
      "skills/**/*",
      "skills-bundle/**/*",
      "models/bge-base-en-v1.5/*",
      "models/bge-base-en-v1.5-gguf/*",
      "docs-corpus/**/*",
      "knowledge-corpus/**/*",
      "licenses/*",
      "capsules/hello/*",
      "capsules/echo-chain/*",
      "../templates/*.json",
      "../templates/_common/**/*",
      "../templates/erc1155/**/*",
      "../templates/erc20/**/*",
      "../templates/erc721/**/*",
      "../templates/erc721-solady/**/*",
      "../templates/governor/**/*",
      "../templates/hello-mint/**/*"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
