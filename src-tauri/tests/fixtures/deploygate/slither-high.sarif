{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Slither",
          "informationUri": "https://github.com/crytic/slither",
          "version": "0.11.6",
          "rules": [
            {
              "id": "0-1-arbitrary-send-eth",
              "name": "arbitrary-send-eth",
              "properties": {
                "precision": "high",
                "security-severity": "8.0"
              },
              "shortDescription": {
                "text": "Functions that send Ether to arbitrary destinations"
              },
              "help": {
                "text": "Ensure that an arbitrary user cannot withdraw unauthorized funds."
              }
            },
            {
              "id": "2-1-missing-zero-check",
              "name": "missing-zero-check",
              "properties": {
                "precision": "high",
                "security-severity": "3.0"
              },
              "shortDescription": {
                "text": "Missing zero address validation"
              },
              "help": {
                "text": "Check that the address is not zero."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "0-1-arbitrary-send-eth",
          "message": {
            "text": "Drain.sweep(address) (src/Drain.sol#5-7) sends eth to arbitrary user\n\tDangerous calls:\n\t- to.transfer(address(this).balance) (src/Drain.sol#6)\n",
            "markdown": "[Drain.sweep(address)](src/Drain.sol#L5-L7) sends eth to arbitrary user\n\tDangerous calls:\n\t- [to.transfer(address(this).balance)](src/Drain.sol#L6)\n"
          },
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/Drain.sol"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 7
                }
              }
            }
          ],
          "partialFingerprints": {
            "id": "db9881228fbc5a9ae7157ad4a619bbdd58e0a5fc7e2f6fdd738e0b128dd6b0ec"
          }
        },
        {
          "ruleId": "2-1-missing-zero-check",
          "message": {
            "text": "Drain.sweep(address).to (src/Drain.sol#5) lacks a zero-check on :\n\t\t- to.transfer(address(this).balance) (src/Drain.sol#6)\n",
            "markdown": "[Drain.sweep(address).to](src/Drain.sol#L5) lacks a zero-check on :\n\t\t- [to.transfer(address(this).balance)](src/Drain.sol#L6)\n"
          },
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/Drain.sol"
                },
                "region": {
                  "startLine": 5,
