          "partialFingerprints": {
            "id": "3728cdb90c22966bc80cb547028f000e6552670c23058d6b89dbbf357cd1075b"
          }
        },
        {
          "ruleId": "2-1-missing-zero-check",
          "message": {
            "text": "HelloMint.constructor(address).owner_ (src/HelloMint.sol#9) lacks a zero-check on :\n\t\t- owner = owner_ (src/HelloMint.sol#10)\n",
            "markdown": "[HelloMint.constructor(address).owner_](src/HelloMint.sol#L9) lacks a zero-check on :\n\t\t- [owner = owner_](src/HelloMint.sol#L10)\n"
          },
